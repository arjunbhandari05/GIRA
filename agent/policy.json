{
  "agent_id": "gira-v1",
  "model": "nvidia/llama-3.3-nemotron-super-49b-v1.5",
  "tool_rules": {
    "required_first_tool": "get_snp_profile",
    "required_before_generate_brief": ["check_safety_flags"],
    "required_for_every_recommendation": ["fetch_pubmed"],
    "max_iterations": 12,
    "max_calls_per_tool": 3
  },
  "forbidden_actions": [
    "write_prescription",
    "external_api_write",
    "skip_safety_check",
    "expose_patient_data",
    "generate_brief_without_safety_check",
    "claim_without_citation"
  ],
  "required_actions": [
    "call_check_safety_flags_before_brief",
    "cite_every_recommendation",
    "write_to_memory_after_brief",
    "physician_review_disclaimer"
  ],
  "inference_constraints": {
    "temperature": 0.1,
    "max_tokens": 1024,
    "output_format": "json_tool_calls_only"
  }
}
