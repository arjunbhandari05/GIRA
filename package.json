{
  "name": "glycoagent",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw agent layer for GlycoAgent",
  "main": "agent/claw.js",
  "type": "module",
  "scripts": {
    "agent": "node agent/heartbeat.js",
