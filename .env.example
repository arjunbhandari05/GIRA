# Copy to .env — never commit real secrets.

# LLM: auto prefers NVIDIA NIM when NVIDIA_API_KEY is set
LLM_BACKEND=auto
NVIDIA_API_KEY=
NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NIM_MAX_TOKENS=4096
NIM_TIMEOUT_SEC=300

# Fallbacks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nemotron-mini

# NCBI E-utilities (PubMed + ClinVar)
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# WHOOP live API (optional — synthetic JSON is default)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_ACCESS_TOKEN=

# Database
MEMORY_DB_PATH=./memory.db

# Synthetic demo data
USE_SYNTHETIC_WHOOP=true
USE_SYNTHETIC_GLUCOSE=true

# Agent tuning
AGENT_MAX_ITERATIONS=12
AGENT_LOG=true
