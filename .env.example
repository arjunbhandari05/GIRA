# Copy to .env — never commit real secrets.

# LLM backend: auto (NIM if NVIDIA_API_KEY set) | nim | openrouter | ollama
LLM_BACKEND=auto
NVIDIA_API_KEY=
NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NIM_MAX_TOKENS=4096
NIM_TIMEOUT_SEC=300

# Optional OpenRouter fallback (legacy /brief if no NVIDIA key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Local Ollama fallback
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nemotron-mini

# NCBI E-utilities (PubMed + ClinVar) — email required; api_key optional but recommended
# https://www.ncbi.nlm.nih.gov/home/develop/api/
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# WHOOP (optional — synthetic JSON is default)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_ACCESS_TOKEN=

# SQLite
MEMORY_DB_PATH=./memory.db

# Synthetic data toggles (true = use bundled demo files)
USE_SYNTHETIC_WHOOP=true
USE_SYNTHETIC_GLUCOSE=true

# Run claw.run even outside a scheduled appointment
FORCE_RUN=false
