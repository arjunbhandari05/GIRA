# Copy to .env — never commit real secrets.

# ── Agent mode (Hack-a-Claw / submission defaults) ──────────────────────────
# llm  = Nemotron ReAct loop: model emits JSON tool_call turns (see reasoning/nemotron.py).
# parallel = scripted tool suite with phased asyncio (faster; good for CI / rate limits).
AGENT_MODE=llm

# Return cached agent briefs on repeat GET /agent_brief (without ?refresh=true).
# Leave false for hackathon demos so each run hits Nemotron/tools fresh.
AGENT_BRIEF_CACHE=false

# Second Nemotron pass: rewrites SNP finding sentences + citation inferences from
# ClinVar/PubMed tool output only (reasoning/pgx_synthesis.py). Requires a reachable LLM.
PGX_SYNTHESIS=1

# Verbose agent logs to stderr during brief runs
AGENT_LOG=true

# LLM: auto prefers NVIDIA NIM when NVIDIA_API_KEY is set
LLM_BACKEND=auto
NVIDIA_API_KEY=
# From https://build.nvidia.com — keys start with nvapi-
NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
NIM_ENABLE_THINKING=true
NIM_REASONING_BUDGET=16384
NIM_MAX_TOKENS=16384
# Agent ReAct loop only — faster demos (follow-up still uses NIM_* above)
NIM_AGENT_ENABLE_THINKING=false
NIM_AGENT_REASONING_BUDGET=4096
NIM_AGENT_MAX_TOKENS=8192
NIM_TIMEOUT_SEC=300
NIM_TEMPERATURE=1
NIM_TOP_P=1

# Fallbacks — OpenRouter Nemotron Super 120B (free tier slug may change)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: agent loop only (e.g. if super is rate-limited — try sponsor nano slug on OpenRouter)
OPENROUTER_AGENT_MODEL=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nemotron-mini

# NCBI E-utilities (PubMed + ClinVar)
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# WHOOP live API (optional — synthetic JSON is default)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_ACCESS_TOKEN=

# Database
MEMORY_DB_PATH=./memory.db

# Synthetic demo data
USE_SYNTHETIC_WHOOP=true
USE_SYNTHETIC_GLUCOSE=true

# Agent tuning
AGENT_MAX_ITERATIONS=12
AGENT_TIMEOUT_SEC=120
AGENT_TOOL_TIMEOUT_SEC=12
BRIEF_ASSEMBLY_TIMEOUT_SEC=12
# Parallel mode: cap external API fan-out (defaults use full lists when unset)
PUBMED_MAX_PAIRS=3
TRIALS_MAX_GENES=3
PGX_SYNTHESIS_TIMEOUT_SEC=20

# ClinVar: cap rsIDs per brief; batch NCBI OR-queries (see apis/clinvar.py)
CLINVAR_MAX_RSIDS=12
CLINVAR_BATCH_SIZE=6

# Directory where per-patient context files are written after agent runs
CONTEXT_DIR=./output/patient_contexts
